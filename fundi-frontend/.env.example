VITE_API_URL=http://localhost:5001

# Browser key restricted to your website domains and to:
# - Maps JavaScript API
# - Places API (New)
# - Geocoding API (used to name the client's current location)
VITE_GOOGLE_MAPS_API_KEY=your_browser_api_key

# Comma-separated ISO country codes used to keep address suggestions relevant.
VITE_GOOGLE_MAPS_REGION_CODES=ke
